# Base URL of the REST API. Leave as /api to use the Vite dev proxy (recommended for local dev).
# For a separately hosted API use the full URL, e.g. https://api.example.com/api
VITE_API_URL=/api
# Where the Vite dev server proxies /api and /uploads during development
VITE_DEV_PROXY_TARGET=http://localhost:5000
# App name shown in the UI
VITE_APP_NAME=TrainovaX
