{
  "name": "trainovax-server",
  "version": "1.0.0",
  "description": "TrainovaX — Fitness & Personal Training Management Platform (REST API)",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node server.js",
    "migrate": "node database/migrate.js",
    "db:reset": "node database/reset.js",
    "db:rename": "node database/rename-db.js",
    "seed": "node seeders/seed.js",
    "seed:masters": "node seeders/addMasters.js",
    "setup": "npm run migrate && npm run seed",
    "test": "node --test --test-concurrency=1 tests/api.test.js"
  },
  "engines": { "node": ">=18" },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.11.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "nodemon": "^3.1.7",
    "supertest": "^7.0.0"
  }
}
